.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 44px;
}

/* ---------------------------------------------------------------- 渐变头 */

.hero {
  display: flex;
  align-items: center;
  padding: 40px 24px 62px;
  background: linear-gradient(135deg,
    var(--color-gradient-from) 0%,
    var(--color-gradient-mid) 60%,
    var(--color-gradient-to) 100%);
}

.avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 62px;
  height: 62px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.28);
  flex: none;
  overflow: hidden;
}

.avatar__img {
  width: 100%;
  height: 100%;
}

/* 人形剪影：纯 CSS，不引图标字体 */
.avatar__head {
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #FFFFFF;
}

.avatar__body {
  width: 24px;
  height: 11px;
  border-radius: 12px 12px 0 0;
  background: #FFFFFF;
  margin-top: 3px;
}

.hero__text {
  flex: 1;
  margin-left: 16px;
}

.hero__name {
  display: block;
  font-size: var(--font-size-h1);
  font-weight: var(--font-weight-bold);
  color: #FFFFFF;
}

.hero__tag {
  display: inline-block;
  margin-top: 8px;
  padding: 3px 12px;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.16);
}

.hero__tag-text {
  font-size: var(--font-size-tiny);
  color: rgba(255, 255, 255, 0.9);
}

.hero__action {
  flex: none;
  margin-left: 12px;
  padding: 10px 18px;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(255, 255, 255, 0.4);
}

.hero__action--primary {
  background: #FFFFFF;
  border-color: #FFFFFF;
}

.hero__action--primary .hero__action-text {
  color: var(--color-primary-dark);
}

.hero__action--hover {
  opacity: 0.7;
}

.hero__action-text {
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-semi);
  color: #FFFFFF;
}

/* ---------------------------------------------------------------- 概览卡：上浮压在头部之上 */

.overview {
  display: flex;
  align-items: center;
  margin: -40px 16px 0;
  padding: 16px 0;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  position: relative;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat__value {
  font-size: var(--font-size-h1);
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
}

.stat__value--accent {
  color: var(--color-primary);
}

.stat__label {
  margin-top: 4px;
  font-size: var(--font-size-tiny);
  color: var(--color-sub);
}

.stat__divider {
  width: 1px;
  height: 26px;
  background: var(--color-line-soft);
}

/* ---------------------------------------------------------------- 分组 */

.section {
  margin: 24px 16px 0;
}

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8px;
  padding: 0 4px;
}

.section__title {
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-semi);
  color: var(--color-sub);
}

.section__hint {
  font-size: var(--font-size-tiny);
  color: var(--color-faint);
}

.section__body {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 4px 16px;
  box-shadow: var(--shadow-card);
}

/* ---------------------------------------------------------------- 数据可信度 */

.grade-bar {
  display: flex;
  height: 8px;
  border-radius: var(--radius-pill);
  overflow: hidden;
  margin-top: 16px;
  background: var(--color-line-soft);
}

.grade-bar__seg {
  height: 8px;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12px;
}

.legend__item {
  display: flex;
  align-items: center;
  margin-right: 16px;
  margin-bottom: 4px;
}

.legend__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  margin-right: 4px;
}

.legend__text {
  font-size: var(--font-size-tiny);
  color: var(--color-sub);
}

.snapshot {
  display: block;
  margin: 12px 0 16px;
  font-size: var(--font-size-tiny);
  color: var(--color-faint);
  line-height: 17px;
}

/* ---------------------------------------------------------------- 行 */

.row {
  display: flex;
  align-items: center;
  height: 50px;
  border-bottom: 1px solid var(--color-line-soft);
}

.row:last-child {
  border-bottom: none;
}

.row--hover {
  opacity: 0.6;
}

.row__label {
  flex: 1;
  font-size: var(--font-size-body);
  color: var(--color-text);
}

.row__value {
  font-size: var(--font-size-small);
  color: var(--color-sub);
}

.chev {
  width: 7px;
  height: 7px;
  border-top: 1.5px solid var(--color-faint);
  border-right: 1.5px solid var(--color-faint);
  transform: rotate(45deg);
  margin-left: 8px;
  flex: none;
}

.tip {
  display: block;
  padding: 12px 0;
  font-size: var(--font-size-tiny);
  color: var(--color-faint);
  line-height: 17px;
}

/* ---------------------------------------------------------------- 空态 */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 0;
}

.empty__clock {
  width: 20px;
  height: 20px;
  border: 2px solid var(--color-faint);
  border-radius: 50%;
}

.empty__text {
  margin-top: 8px;
  font-size: var(--font-size-body);
  color: var(--color-sub);
}

.empty__sub {
  margin-top: 4px;
  font-size: var(--font-size-tiny);
  color: var(--color-faint);
  text-align: center;
}

/* ---------------------------------------------------------------- 退出 */

.exit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  margin: 32px 16px 0;
  border-radius: var(--radius-pill);
  border: 1px solid var(--color-line);
  background: var(--color-card);
}

.exit--hover {
  background: var(--color-flat-bg);
}

.exit__text {
  font-size: var(--font-size-body);
  color: var(--color-sub);
}

.disclaimer {
  display: block;
  margin-top: 24px;
  text-align: center;
  font-size: var(--font-size-tiny);
  color: var(--color-faint);
}
