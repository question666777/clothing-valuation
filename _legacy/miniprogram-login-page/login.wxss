.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* ---------------------------------------------------------------- 品牌区 */

.brand {
  position: relative;
  overflow: hidden;
  padding: 72px 24px 78px;
  background: linear-gradient(135deg,
    var(--color-gradient-from) 0%,
    var(--color-gradient-mid) 55%,
    var(--color-gradient-to) 100%);
}

/* 装饰光晕：纯 CSS 圆形，不引图片 */
.halo {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.halo--a {
  width: 200px;
  height: 200px;
  top: -60px;
  right: -50px;
}

.halo--b {
  width: 130px;
  height: 130px;
  bottom: -40px;
  left: -30px;
}

.brand__inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border-radius: var(--radius-xl);
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.24);
}

/* 扫描框：两个对角括号，纯 CSS 画 */
.mark__scan {
  position: relative;
  width: 24px;
  height: 24px;
}

.mark__scan::before,
.mark__scan::after {
  content: '';
  position: absolute;
  width: 9px;
  height: 9px;
}

.mark__scan::before {
  top: 0;
  left: 0;
  border-top: 2px solid #FFFFFF;
  border-left: 2px solid #FFFFFF;
}

.mark__scan::after {
  bottom: 0;
  right: 0;
  border-bottom: 2px solid #FFFFFF;
  border-right: 2px solid #FFFFFF;
}

.brand__name {
  margin-top: 16px;
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  color: #FFFFFF;
  letter-spacing: 4px;
}

.brand__slogan {
  margin-top: 8px;
  font-size: var(--font-size-small);
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 0.5px;
}

/* ---------------------------------------------------------------- 表单卡 */

.sheet {
  margin-top: -42px;
  background: var(--color-card);
  border-top-left-radius: var(--radius-xxl);
  border-top-right-radius: var(--radius-xxl);
  padding: 32px 24px 32px;
}

.sheet__title {
  display: block;
  font-size: var(--font-size-h1);
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
}

.sheet__subtitle {
  display: block;
  margin-top: 4px;
  margin-bottom: 24px;
  font-size: var(--font-size-small);
  color: var(--color-sub);
}

.field-box {
  display: flex;
  align-items: center;
  height: 54px;
  border-radius: var(--radius-md);
  background: var(--color-card-alt);
  border: 1px solid var(--color-line);
  padding: 0 16px;
  margin-bottom: 12px;
}

.field-box--error {
  border-color: var(--color-warn);
  background: var(--color-warn-bg);
}

.field-box__input {
  flex: 1;
  font-size: var(--font-size-body);
  color: var(--color-text);
}

.prefix {
  display: flex;
  align-items: center;
}

.prefix__text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semi);
  color: var(--color-text);
}

.prefix__divider {
  width: 1px;
  height: 18px;
  background: var(--color-line);
  margin: 0 12px;
}

.code-btn {
  padding-left: 12px;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-semi);
  color: var(--color-primary);
  flex: none;
}

.code-btn--off {
  color: var(--color-faint);
  font-weight: var(--font-weight-normal);
}

.error-row {
  margin-bottom: 8px;
}

.error-row__text {
  font-size: var(--font-size-small);
  color: var(--color-warn);
}

.agree-row {
  display: flex;
  align-items: flex-start;
  margin-top: 4px;
  margin-bottom: 16px;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 17px;
  border-radius: 5px;
  border: 1.5px solid var(--color-line);
  margin-right: 8px;
  margin-top: 1px;
  flex: none;
}

.checkbox--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox__tick {
  width: 8px;
  height: 4px;
  border-left: 2px solid #FFFFFF;
  border-bottom: 2px solid #FFFFFF;
  transform: rotate(-45deg) translate(1px, -1px);
}

.agree-row__text {
  flex: 1;
  font-size: var(--font-size-tiny);
  color: var(--color-sub);
  line-height: 18px;
}

.agree-row__link {
  color: var(--color-primary);
}

.or {
  display: flex;
  align-items: center;
  margin: 24px 0;
}

.or__line {
  flex: 1;
  height: 1px;
  background: var(--color-line-soft);
}

.or__text {
  margin: 0 12px;
  font-size: var(--font-size-tiny);
  color: var(--color-faint);
}

.guest {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--color-primary-soft);
  background: var(--color-primary-ghost);
}

.guest--hover {
  background: var(--color-primary-soft);
}

.guest__lens {
  width: 14px;
  height: 14px;
  border: 2px solid var(--color-primary);
  border-radius: 50%;
  margin-right: 8px;
}

.guest__text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semi);
  color: var(--color-primary);
}

.foot-hint {
  display: block;
  margin-top: 16px;
  font-size: var(--font-size-tiny);
  color: var(--color-faint);
  text-align: center;
  line-height: 17px;
}
