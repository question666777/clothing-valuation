<view class="hero">
  <view class="hero-title">买东西前拍一下</view>
  <view class="hero-sub">看看它到底值多少钱</view>
</view>

<view class="card">
  <view class="section-title">物品信息</view>

  <view class="field">
    <text class="field-label">物品名称</text>
    <input class="field-input" value="{{itemName}}" bindinput="onNameInput" placeholder="如 iPhone 数据线" />
  </view>

  <view class="field">
    <text class="field-label">品类</text>
    <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="field-picker">{{categories[categoryIndex].label}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="field-label">品牌档位</text>
    <picker mode="selector" range="{{brandTiers}}" range-key="label" value="{{brandIndex}}" bindchange="onBrandChange">
      <view class="field-picker">{{brandTiers[brandIndex].label}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="field-label">材料成本（元）</text>
    <input class="field-input" type="digit" value="{{materialPrice}}" bindinput="onPriceInput" placeholder="如 1200" />
  </view>
</view>

<view class="actions">
  <view class="btn-primary" bindtap="onEstimate">开始估价</view>
  <view class="btn-ghost" bindtap="onScan">拍照识别（待接入）</view>
</view>

<view class="disclaimer">估值仅供参考，不构成购买建议</view>
