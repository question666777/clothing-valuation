.range-card {
  background: #1f2329;
  color: #ffffff;
  padding: 56rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.range-label {
  font-size: 26rpx;
  color: #a8adb5;
}

.range-value {
  font-size: 60rpx;
  font-weight: 600;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

.range-mid {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #a8adb5;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.part {
  margin-bottom: 36rpx;
}

.part:last-child {
  margin-bottom: 0;
}

.part-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.part-label {
  font-size: 28rpx;
}

.part-value {
  font-size: 30rpx;
  font-weight: 600;
}

.bar {
  height: 14rpx;
  background: #eef0f3;
  border-radius: 8rpx;
  margin: 12rpx 0 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #1f2329;
  border-radius: 8rpx;
}

.part-foot {
  display: flex;
  justify-content: space-between;
  color: #8b9098;
  font-size: 24rpx;
}

.warn {
  color: #b06a00;
  font-size: 26rpx;
}

.actions {
  padding: 8rpx 24rpx 40rpx;
}
